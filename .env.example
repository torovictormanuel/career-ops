# ==============================================================================
# career-ops v2.0 — Environment Variables
# Copia este archivo a .env y completá tus valores.
#
#   cp .env.example .env
#
# REGLA: Nunca committear el .env real. Solo este .env.example va al repo.
# ==============================================================================

# ── LLM — Claude (Anthropic) ──────────────────────────────────────────────────
# Requerido para: LLM Scorer, Cover Letter Generator
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LLM — Gemini (Google) ─────────────────────────────────────────────────────
# Requerido para: node gemini-eval.mjs (evaluación alternativa)
# Obtener gratis en: https://aistudio.google.com/apikey
# Tier gratuito: 15 RPM / 1M tokens/día con gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Override del modelo Gemini (opcional)
# GEMINI_MODEL=gemini-2.0-flash

# ── WhatsApp Bot ──────────────────────────────────────────────────────────────
# Requerido para: node whatsapp-bot.mjs / start-bot.bat
# Formato: código de país + número SIN + ni espacios
# Ejemplo Argentina: 5491112345678
WA_MY_NUMBER=your_full_number_here

# Puerto del servidor HTTP local que n8n llama (default: 3099)
# WA_BOT_PORT=3099

# ── Pipeline — Configuración de batch ────────────────────────────────────────
# Score mínimo para notificar por WhatsApp (default: 3.5)
BATCH_MIN_SCORE=3.5

# Máximo de ofertas a evaluar por ejecución (protege tokens de LLM)
BATCH_MAX=30

# ── Portales con login requerido ──────────────────────────────────────────────
# Computrabajo — necesita cuenta para ver JDs completos
COMPUTRABAJO_EMAIL=your_email_here
COMPUTRABAJO_PASS=your_password_here

# ZonaJobs — ídem
ZONAJOBS_EMAIL=your_email_here
ZONAJOBS_PASS=your_password_here

# ── Sistema v2.0 ──────────────────────────────────────────────────────────────
# Modo dry-run: no envía mensajes WA ni escribe en archivos de producción
# Útil para testing. Valores: true | false
CAREER_OPS_DRY_RUN=false

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# TTL del dedup-index en días (URLs se re-scanean después de N días)
DEDUP_TTL_DAYS=90

# ── n8n Orchestrator ──────────────────────────────────────────────────────────
# URL base del servidor n8n (para llamadas entre agentes)
# N8N_BASE_URL=http://localhost:5678

# Webhook URL que n8n expone para el scanner (si se usa webhook en vez de cron)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/career-ops-scan

# ── Futuras integraciones (descomentar cuando se implementen) ─────────────────
# OPENAI_API_KEY=your_openai_key_here      # Alternativa a Claude
# CLEARBIT_API_KEY=your_clearbit_key_here  # Company enricher (plan free)
# SLACK_WEBHOOK_URL=your_slack_webhook     # Notificaciones alternativas a WA
